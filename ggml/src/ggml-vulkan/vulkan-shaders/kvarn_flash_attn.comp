#ifdef KVAR_RECORD_TILE
// Largest KVarN record: 128x128 at 8 bits plus three FP16 axis vectors.
// A decode split stages one K or V record at a time, so the same LDS region is
// reused for every head slice and for both operands.
shared uint sh_record_cache[8u * 512u + 192u];
shared float sh_block_score[GQA_GROUP_MAX * 64u];
shared float sh_block_weight[GQA_GROUP_MAX * 64u];
shared uint sh_block_enabled[GQA_GROUP_MAX * 64u];
#endif

uint read_index_low(bool value, uint token) {
    return value && (p.flags & FLAG_SHARED_INDICES) == 0u ?
        data_vindex[2u * token] : data_kindex[2u * token];
}

int read_cell(bool value, uint token, bool swa, out bool explicitly_staged) {
    const int encoded = int(read_index_low(value, token));
    explicitly_staged = encoded < -1;
    return explicitly_staged ? -encoded - 2 : encoded;
}

float load_stage(bool value, uint stage_pos, uint head, uint dim) {
    const uint index = (stage_pos * p.n_heads + head) * 64u + (dim >> 1u);
    const vec2 pair = unpackHalf2x16(value ? data_vstage[index] : data_kstage[index]);
    return (dim & 1u) == 0u ? pair.x : pair.y;
}

uint load_record_word(bool value, uint index) {
    return value ? data_vrecord[index] : data_krecord[index];
}

uint unpack_record(bool value, uint record_base, uint index, uint bits) {
    const uint bit_offset = index * bits;
    const uint word_index = bit_offset >> 5u;
    const uint bit = bit_offset & 31u;
    uint result = load_record_word(value, record_base + word_index) >> bit;
    if (bit + bits > 32u) {
        result |= load_record_word(value, record_base + word_index + 1u) << (32u - bit);
    }
    return result & ((1u << bits) - 1u);
}

uint unpack_record4_item(uint lo, uint hi, uint bit, uint bits) {
    uint result;
    if (bit < 32u) {
        result = lo >> bit;
        if (bit + bits > 32u) {
            result |= hi << (32u - bit);
        }
    } else {
        result = hi >> (bit - 32u);
    }
    return result & ((1u << bits) - 1u);
}

uvec4 unpack_record4(bool value, uint record_base, uint index, uint bits) {
    const uint bit_offset = index * bits;
    const uint word_index = bit_offset >> 5u;
    const uint bit = bit_offset & 31u;
    const uint lo = load_record_word(value, record_base + word_index);
    const uint hi = load_record_word(value, record_base + word_index + 1u);
    return uvec4(
        unpack_record4_item(lo, hi, bit, bits),
        unpack_record4_item(lo, hi, bit + bits, bits),
        unpack_record4_item(lo, hi, bit + 2u * bits, bits),
        unpack_record4_item(lo, hi, bit + 3u * bits, bits));
}

float load_axis(
        bool value,
        uint record_base,
        uint payload_words,
        uint axis,
        uint index) {
    const vec2 pair = unpackHalf2x16(load_record_word(
        value, record_base + payload_words + axis * 64u + (index >> 1u)));
    return (index & 1u) == 0u ? pair.x : pair.y;
}

#ifndef KVAR_PRECOMPUTED_LIVE
void compute_live(
        bool value,
        uint stream,
        uint lane,
        out uint live_group,
        out uint live_pos) {
    uint group_best = 0u;
    uint pos_best = 0u;
    for (uint i = lane; i < p.n_indices; i += gl_WorkGroupSize.x) {
        const bool swa = (p.flags & FLAG_SWA) != 0u;
        bool explicitly_staged;
        const int index = read_cell(value, i, swa, explicitly_staged);
        if (index == -1) {
            continue;
        }
        const uint global_group = uint(index) / KVAR_N_DIM;
        const uint index_stream = swa ?
            stream : global_group / groups_per_stream();
        if (index_stream != stream) {
            continue;
        }
        const uint group = swa ?
            global_group : global_group - stream * groups_per_stream();
        const uint pos = uint(index) % KVAR_N_DIM;
        if (group > group_best || (group == group_best && pos > pos_best)) {
            group_best = group;
            pos_best = pos;
        }
    }
    sh_live_group[lane] = group_best;
    sh_live_pos[lane] = pos_best;
    barrier();
    for (uint stride = gl_WorkGroupSize.x >> 1u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            const uint other_group = sh_live_group[lane + stride];
            const uint other_pos = sh_live_pos[lane + stride];
            if (other_group > sh_live_group[lane] ||
                    (other_group == sh_live_group[lane] &&
                     other_pos > sh_live_pos[lane])) {
                sh_live_group[lane] = other_group;
                sh_live_pos[lane] = other_pos;
            }
        }
        barrier();
    }
    live_group = sh_live_group[0];
    live_pos = sh_live_pos[0];
}
#endif

float load_kvarn(
        bool value,
        uint logical_head,
        uint token,
        uint stream,
        uint live_group,
        uint live_pos,
        uint slice,
        uint dim) {
    const bool swa = (p.flags & FLAG_SWA) != 0u;
    bool explicitly_staged = false;
    const int absolute_pos = (swa || read_indirect()) ?
        read_cell(value, token, swa, explicitly_staged) : int(token);
    if (absolute_pos == -1) {
        return 0.0;
    }

    const uint group = uint(absolute_pos) / KVAR_N_DIM;
    const uint pos = uint(absolute_pos) % KVAR_N_DIM;
    bool from_stage = false;
    bool from_record = false;
    if (explicitly_staged) {
        from_stage = true;
    } else if (read_indirect() && !swa) {
        from_stage = explicitly_staged;
        from_record = !from_stage;
    } else if ((p.flags & FLAG_EAGER) != 0u) {
        from_stage = (!swa && group == 0u) ||
            (group == live_group && live_pos < 127u);
        const bool completed = group < live_group ||
            (group == live_group && live_pos == 127u);
        from_record = !from_stage && completed && (swa ?
            (group <= live_group && live_group - group < groups_per_stream()) :
            (group > 0u && group < groups_per_stream()));
    } else if (swa) {
        const uint stage_begin = live_group >= tail_groups() - 1u ?
            live_group - (tail_groups() - 1u) : 0u;
        from_stage = group >= stage_begin && group <= live_group;
        from_record = !from_stage && group < stage_begin &&
            live_group - group < groups_per_stream() + tail_groups();
    } else {
        from_stage = group == 0u ||
            (group > 0u && group <= live_group &&
             group + (tail_groups() - 1u) >= live_group);
        from_record = !from_stage && group < live_group &&
            group < groups_per_stream();
    }

    const uint head = logical_head * head_slices() + slice;
    if (from_stage) {
        const uint stage_slot = swa ? group % stage_groups() :
            (group == 0u ? 0u : 1u + ((group - 1u) % tail_groups()));
        const uint stage_pos = stream * KVAR_N_DIM * stage_groups() +
            stage_slot * KVAR_N_DIM + pos;
        return load_stage(value, stage_pos, head, dim);
    }
    if (from_record) {
        const uint ring = swa ? group % groups_per_stream() : group;
        const uint bits = value ? v_bits() : k_bits();
        const uint record_words = bits * 512u + 192u;
        const uint record_base =
            ((stream * groups_per_stream() + ring) * p.n_heads + head) *
            record_words;
        const uint row = value ? pos : dim;
        const uint col = value ? dim : pos;
        const uint payload_words = bits * 512u;
        const uint quant = unpack_record(
            value, record_base, row * KVAR_N_DIM + col, bits);
        const float scale = load_axis(value, record_base, payload_words, 0u, row);
        const float zero = load_axis(value, record_base, payload_words, 1u, row);
        const float other = load_axis(value, record_base, payload_words, 2u, col);
        return (float(quant) * scale + zero) * other;
    }
    return 0.0;
}

float load_mask(uint token, uint query, uint stream) {
    const uint half_index = token + query * p.n_kv +
        (stream % mask_ne3()) * p.n_kv * n_query();
    const vec2 pair = unpackHalf2x16(data_mask[half_index >> 1u]);
    return (half_index & 1u) == 0u ? pair.x : pair.y;
}

float load_u16_word(uint word, uint half_index, bool bf16) {
    const uint bits = (word >> ((half_index & 1u) * 16u)) & 0xffffu;
    if (bf16) {
        return uintBitsToFloat(bits << 16u);
    }
    const vec2 pair = unpackHalf2x16(word);
    return (half_index & 1u) == 0u ? pair.x : pair.y;
}

float load_tail(bool value, uint slot, uint head, uint dim) {
    const uint history_slots = p.flags >> FLAG_TAIL_HISTORY_SHIFT;
    const bool from_current =
        (p.flags & FLAG_TAIL_CURRENT) != 0u && slot >= history_slots;
    const uint source_slot = from_current ? slot - history_slots : slot;
    const uint half_index = value ?
        source_slot * p.v_tail_nb1 + head * p.v_tail_nb2 + dim :
        source_slot * p.k_tail_nb1 + head * p.k_tail_nb2 + dim;
    uint word;
    if (from_current) {
        TailCurrentRef current = TailCurrentRef(
            value ? p.v_tail_current_addr : p.k_tail_current_addr);
        word = current.data[half_index >> 1u];
    } else {
        word = value ? data_vtail[half_index >> 1u] : data_ktail[half_index >> 1u];
    }
    const bool bf16 = value ?
        (p.flags & FLAG_V_TAIL_BF16) != 0u :
        (p.flags & FLAG_K_TAIL_BF16) != 0u;
    return load_u16_word(word, half_index, bf16);
}

float load_tail_mask(uint token, uint query, uint stream) {
    const uint half_index = token + query * tail_stride() +
        stream * tail_stride() * n_query();
    TailMaskRef tail_mask = TailMaskRef(p.tail_mask_addr);
    return load_u16_word(
        tail_mask.data[half_index >> 1u], half_index, false);
}

#ifdef KVAR_RECORD_TILE
uint unpack_cached_record(uint index, uint bits) {
    const uint bit_offset = index * bits;
    const uint word_index = bit_offset >> 5u;
    const uint bit = bit_offset & 31u;
    uint result = sh_record_cache[word_index] >> bit;
    if (bit + bits > 32u) {
        result |= sh_record_cache[word_index + 1u] << (32u - bit);
    }
    return result & ((1u << bits) - 1u);
}

float load_cached_axis(uint payload_words, uint axis, uint index) {
    const vec2 pair = unpackHalf2x16(
        sh_record_cache[payload_words + axis * 64u + (index >> 1u)]);
    return (index & 1u) == 0u ? pair.x : pair.y;
}

void cache_record(bool value, uint record_base, uint record_words, uint lane) {
    for (uint i = lane; i < record_words; i += gl_WorkGroupSize.x) {
        sh_record_cache[i] = load_record_word(value, record_base + i);
    }
    barrier();
}
#endif

bool direct_body_record_available(
        bool value,
        uint group,
        uint live_group,
        uint live_pos) {
    if ((p.flags & FLAG_SWA) != 0u || read_indirect()) {
        return false;
    }
    if ((p.flags & FLAG_EAGER) != 0u) {
        const bool from_stage = group == 0u ||
            (group == live_group && live_pos < 127u);
        const bool completed = group < live_group ||
            (group == live_group && live_pos == 127u);
        return !from_stage && completed && group > 0u &&
            group < groups_per_stream();
    }
    const bool from_stage = group == 0u ||
        (group > 0u && group <= live_group &&
         group + (tail_groups() - 1u) >= live_group);
    return !from_stage && group < live_group && group < groups_per_stream();
}

uint direct_record_base(
        bool value,
        uint stream,
        uint group,
        uint logical_head,
        uint slice) {
    const uint bits = value ? v_bits() : k_bits();
    const uint record_words = bits * 512u + 192u;
    const uint head = logical_head * head_slices() + slice;
    return ((stream * groups_per_stream() + group) * p.n_heads + head) *
        record_words;
}

#ifdef KVAR_COOPMAT

// RDNA3 decode and short-verification route.  Each of the four wave64
// subgroups handles one 16-token quarter of a 64-token split.  GQA heads are
// matrix rows, so K/V reconstruction is shared across all heads instead of
// being repeated by independent attention workgroups.
void main() {
    if (gl_NumSubgroups != 4u) {
        return;
    }

    const uint lane = gl_LocalInvocationID.x;
    const uint wave = gl_SubgroupID;
    const uint wave_lane = gl_SubgroupInvocationID;
    const uint split_k = max(body_splits() + tail_splits(), 1u);
    const bool body_only_dispatch = dispatch_mode() == 1u;
    const bool tail_only_dispatch = dispatch_mode() == 2u;
    const uint dispatch_splits = body_only_dispatch ?
        max(body_splits(), 1u) :
        (tail_only_dispatch ? max(tail_splits(), 1u) : split_k);
    const uint dispatch_split = gl_WorkGroupID.x % dispatch_splits;
    const uint split_index = tail_only_dispatch ?
        body_splits() + dispatch_split : dispatch_split;
    const uint query_group = gl_WorkGroupID.x / dispatch_splits;
    const uint out_stream = gl_WorkGroupID.z;
    const uint stream = stream_start() + out_stream;
    const uint n_kv_heads = p.n_heads / head_slices();
    const uint n_query_heads = n_kv_heads * gqa();
    // Body and exact-tail tiles share the same sequence-wide K/V rows. Pack
    // multiple queries into the 16 cooperative-matrix rows for both routes;
    // their different causal visibility remains encoded in the masks.
    const uint query_pack = cooperative_query_pack();
    const uint query_groups = gl_NumWorkGroups.x / dispatch_splits;
    const uint tile_queries = min(query_groups * query_pack,
        n_query() - query_base());
    const uint local_query_base = query_group * query_pack;
    const uint queries_here = min(query_pack,
        tile_queries - min(local_query_base, tile_queries));
    const uint query = query_base() + local_query_base;
    const uint logical_head = gl_WorkGroupID.y;
    const uint query_head_first = logical_head * gqa();
#ifdef KVAR_COOPMAT_PREFILL
    const uint queries_per_matrix = max(1u, 16u / gqa());
    const uint first_queries = min(queries_here, queries_per_matrix);
    const uint second_queries = min(
        queries_here - first_queries, queries_per_matrix);
    const uint third_queries = queries_here - first_queries - second_queries;
    const uint active_rows = first_queries * gqa();
    const uint second_active_rows = second_queries * gqa();
    const uint third_active_rows = third_queries * gqa();
    const uint matrix_batches = min(COOPMAT_MATRIX_BATCHES,
        third_queries > 0u ? 3u : (second_queries > 0u ? 2u : 1u));
#else
    const uint active_rows = queries_here * gqa();
#endif
    const bool has_tail = (p.flags & FLAG_TAIL) != 0u && !body_only_dispatch;
    const uint n_body_splits = body_splits();
    const uint n_tail_splits = tail_splits();
    const bool process_body = body_only_dispatch ||
        (!tail_only_dispatch && split_index < n_body_splits);
    const bool process_tail = has_tail && split_index >= n_body_splits &&
        split_index < n_body_splits + n_tail_splits;

    if (lane == 0u) {
        sh_active = -1;
        if (has_tail) {
            QueryOrderRef query_order = QueryOrderRef(p.query_order_addr);
            for (uint local_query = 0u; local_query < queries_here; ++local_query) {
                const int query_id = int(out_stream * n_query() + query + local_query);
                int active_desc = -1;
                for (uint packed = 0u; packed < p.query_order_nelements; ++packed) {
                    if (query_order.data[packed] == query_id) {
                        active_desc = int(packed / query_order_ne0());
                        break;
                    }
                }
                if (active_desc < 0 || (sh_active >= 0 && active_desc != sh_active)) {
                    sh_active = -1;
                    break;
                }
                sh_active = active_desc;
            }
        }
    }
    barrier();
    if (has_tail && sh_active < 0) {
        return;
    }

    uint k_live_group = 0u;
    uint k_live_pos = 0u;
    uint v_live_group = 0u;
    uint v_live_pos = 0u;
#ifdef KVAR_PRECOMPUTED_LIVE
    const uint k_live_base = 2u * out_stream;
    const uint v_live_base = (p.flags & FLAG_SHARED_INDICES) != 0u ?
        k_live_base : 2u * gl_NumWorkGroups.z + k_live_base;
    k_live_group = data_live[k_live_base + 0u];
    k_live_pos = data_live[k_live_base + 1u];
    v_live_group = data_live[v_live_base + 0u];
    v_live_pos = data_live[v_live_base + 1u];
#else
    compute_live(false, stream, lane, k_live_group, k_live_pos);
    if ((p.flags & FLAG_SHARED_INDICES) != 0u) {
        v_live_group = k_live_group;
        v_live_pos = k_live_pos;
    } else {
        compute_live(true, stream, lane, v_live_group, v_live_pos);
    }
#endif

#ifdef KVAR_HEAD_DIM
    const uint head_dim = uint(KVAR_HEAD_DIM);
#else
    const uint head_dim = head_slices() * KVAR_N_DIM;
#endif
    const uint body_tile_count = (p.n_kv + 63u) / 64u;
    uint split_tile_begin = 0u;
    uint split_tile_end = 0u;
    uint tail_token_count = 0u;
    if (process_body) {
        split_tile_begin = body_tile_count * split_index /
            max(n_body_splits, 1u);
        split_tile_end = body_tile_count * (split_index + 1u) /
            max(n_body_splits, 1u);
    } else if (process_tail) {
        RunDescRef run_desc = RunDescRef(p.run_desc_addr);
        const uint desc_base = uint(sh_active) * p.run_desc_ne0;
        tail_token_count = uint(max(run_desc.data[desc_base + 4u], 0));
        const uint tail_split = split_index - n_body_splits;
        split_tile_begin = tail_split;
        split_tile_end = tail_split + 1u;
    }

#ifdef KVAR_COOPMAT_PREFILL
    // A prefill workgroup can own several 64-token record tiles. Keep its
    // partial numerator in registers and merge tile-local softmax statistics
    // online, avoiding one global workspace plane and reducer input per tile.
    // Cache this invocation's query element for every 16-wide dimension slice.
    // Reusing it across all body tiles avoids rereading the query tensor once
    // per record, which matters increasingly as the populated context grows.
    float16_t query_cache[KVAR_COOPMAT_MATRIX_BATCHES * KVAR_COOPMAT_DIM_BLOCKS];
    float accumulator[KVAR_COOPMAT_MATRIX_BATCHES * KVAR_COOPMAT_DIM_BLOCKS];
    for (uint i = 0u; i < COOPMAT_MATRIX_BATCHES * COOPMAT_DIM_BLOCKS; ++i) {
        accumulator[i] = 0.0;
    }
    const uint cached_q_row = lane >> 4u;
    const uint cached_q_dim_local = lane & 15u;
    for (uint matrix_batch = 0u; matrix_batch < matrix_batches; ++matrix_batch) {
        const uint batch_active_rows = matrix_batch == 0u ? active_rows :
            (matrix_batch == 1u ? second_active_rows : third_active_rows);
        const uint batch_query_base = matrix_batch * queries_per_matrix;
        for (uint dim_base = 0u; dim_base < head_dim; dim_base += 16u) {
            float q_value = 0.0;
            if (cached_q_row < batch_active_rows) {
                const uint row_query = query_base() + local_query_base +
                    batch_query_base + cached_q_row / gqa();
                const uint query_head = query_head_first + cached_q_row % gqa();
                const uint q_base = row_query * q_nb1() + query_head * q_nb2() +
                    out_stream * head_dim * n_query() * n_query_heads;
                q_value = uintBitsToFloat(
                    data_q[q_base + dim_base + cached_q_dim_local]) * p.scale;
            }
            query_cache[matrix_batch * COOPMAT_DIM_BLOCKS + dim_base / 16u] =
                float16_t(q_value);
        }
    }
#endif
#ifdef KVAR_COOPMAT_PREFILL
    if (lane < matrix_batches * 16u) {
        const uint matrix_batch = lane >> 4u;
        const uint row = lane & 15u;
        const uint batch_active_rows = matrix_batch == 0u ? active_rows :
            (matrix_batch == 1u ? second_active_rows : third_active_rows);
        if (row < batch_active_rows) {
            sh_maximum[matrix_batch * 16u + row] = -3.402823466e38;
            sh_denominator[matrix_batch * 16u + row] = 0.0;
        }
    }
    barrier();
#endif

    const uint matrix_values = head_dim * tile_queries * n_query_heads *
        gl_NumWorkGroups.z * split_k;

    for (uint split_tile = split_tile_begin;
            split_tile < split_tile_end; ++split_tile) {
    const uint token_begin = split_tile * 64u;
    const uint token_end = min(token_begin + 64u,
        process_body ? p.n_kv : tail_token_count);
    const uint tile_tokens = token_end - min(token_begin, token_end);

    if (process_tail) {
        RunDescRef run_desc = RunDescRef(p.run_desc_addr);
        const uint desc_base = uint(sh_active) * p.run_desc_ne0;
        for (uint local_token = lane; local_token < 64u;
                local_token += gl_WorkGroupSize.x) {
            sh_cm_tail_slot[local_token] = local_token < tile_tokens ?
                uint(run_desc.data[desc_base + 6u + token_begin + local_token]) : 0u;
        }
    }

    const uint body_group = token_begin / KVAR_N_DIM;
    const bool fast_record = process_body && tile_tokens > 0u &&
        token_end <= (body_group + 1u) * KVAR_N_DIM &&
        direct_body_record_available(false, body_group, k_live_group, k_live_pos) &&
        direct_body_record_available(true, body_group, v_live_group, v_live_pos);

    if (fast_record) {
        for (uint dim = lane; dim < head_dim; dim += gl_WorkGroupSize.x) {
            const uint slice = dim >> 7u;
            const uint slice_dim = dim & 127u;
            const uint k_base = direct_record_base(
                false, stream, body_group, logical_head, slice);
            const uint v_base = direct_record_base(
                true, stream, body_group, logical_head, slice);
            sh_cm_dim_axes[0u * COOPMAT_MAX_HEAD_DIM + dim] = float16_t(load_axis(
                false, k_base, k_bits() * 512u, 0u, slice_dim));
            sh_cm_dim_axes[1u * COOPMAT_MAX_HEAD_DIM + dim] = float16_t(load_axis(
                false, k_base, k_bits() * 512u, 1u, slice_dim));
            sh_cm_dim_axes[2u * COOPMAT_MAX_HEAD_DIM + dim] = float16_t(load_axis(
                true, v_base, v_bits() * 512u, 2u, slice_dim));
        }
        for (uint i = lane; i < 64u * head_slices();
                i += gl_WorkGroupSize.x) {
            const uint local_token = i / head_slices();
            const uint slice = i - local_token * head_slices();
            if (local_token < tile_tokens) {
                const uint pos = (token_begin + local_token) & 127u;
                const uint k_base = direct_record_base(
                    false, stream, body_group, logical_head, slice);
                const uint v_base = direct_record_base(
                    true, stream, body_group, logical_head, slice);
                sh_cm_token_axes[(0u * COOPMAT_MAX_HEAD_SLICES + slice) * 64u + local_token] = float16_t(load_axis(
                    false, k_base, k_bits() * 512u, 2u, pos));
                sh_cm_token_axes[(1u * COOPMAT_MAX_HEAD_SLICES + slice) * 64u + local_token] = float16_t(load_axis(
                    true, v_base, v_bits() * 512u, 0u, pos));
                sh_cm_token_axes[(2u * COOPMAT_MAX_HEAD_SLICES + slice) * 64u + local_token] = float16_t(load_axis(
                    true, v_base, v_bits() * 512u, 1u, pos));
            }
        }
    }
    barrier();

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> score_mat =
        coopmat<float, gl_ScopeSubgroup, 16, 16,
            gl_MatrixUseAccumulator>(0.0);
#ifdef KVAR_COOPMAT_PREFILL
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> score_mat_second =
        coopmat<float, gl_ScopeSubgroup, 16, 16,
            gl_MatrixUseAccumulator>(0.0);
#if KVAR_COOPMAT_MATRIX_BATCHES > 2
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> score_mat_third =
        coopmat<float, gl_ScopeSubgroup, 16, 16,
            gl_MatrixUseAccumulator>(0.0);
#endif
#endif
    for (uint dim_base = 0u; dim_base < head_dim; dim_base += 16u) {
        // Applying the scale before FP16 conversion matches the established
        // Vulkan cooperative-matrix FA path. Each invocation owns one element
        // of this 16x16 query slice.
        const uint q_row = lane >> 4u;
        const uint q_dim_local = lane & 15u;
#ifdef KVAR_COOPMAT_PREFILL
        sh_cm_q_or_p[q_row * 16u + q_dim_local] =
            query_cache[dim_base / 16u];
        if (matrix_batches > 1u) {
            sh_cm_q_or_p[64u * 16u + q_row * 16u + q_dim_local] =
                query_cache[COOPMAT_DIM_BLOCKS + dim_base / 16u];
        }
#if KVAR_COOPMAT_MATRIX_BATCHES > 2
        if (matrix_batches > 2u) {
            sh_cm_q_or_p[2u * 64u * 16u + q_row * 16u + q_dim_local] =
                query_cache[2u * COOPMAT_DIM_BLOCKS + dim_base / 16u];
        }
#endif
#else
        float q_value = 0.0;
        if (q_row < active_rows) {
            const uint row_query = query_base() + local_query_base + q_row / gqa();
            const uint query_head = query_head_first + q_row % gqa();
            const uint q_base = row_query * q_nb1() + query_head * q_nb2() +
                out_stream * head_dim * n_query() * n_query_heads;
            q_value = uintBitsToFloat(data_q[q_base + dim_base + q_dim_local]) * p.scale;
        }
        sh_cm_q_or_p[q_row * 16u + q_dim_local] = float16_t(q_value);
#endif

        if (fast_record) {
            // Four adjacent token values share one packed word pair.
            const uint dim_local = lane >> 4u;
            const uint local_token_base = (lane & 15u) * 4u;
            const uint dim = dim_base + dim_local;
            const uint slice = dim >> 7u;
            const uint slice_dim = dim & 127u;
            const uint pos_base =
                (token_begin + local_token_base) & 127u;
            const uint record_base = direct_record_base(
                false, stream, body_group, logical_head, slice);
            const uvec4 quant = unpack_record4(false, record_base,
                slice_dim * KVAR_N_DIM + pos_base, k_bits());
            for (uint j = 0u; j < 4u; ++j) {
                const uint local_token = local_token_base + j;
                float value = 0.0;
                if (local_token < tile_tokens) {
                    value = (float(quant[j]) *
                                float(sh_cm_dim_axes[0u * COOPMAT_MAX_HEAD_DIM + dim]) +
                                float(sh_cm_dim_axes[1u * COOPMAT_MAX_HEAD_DIM + dim])) *
                        float(sh_cm_token_axes[
                            (0u * COOPMAT_MAX_HEAD_SLICES + slice) * 64u + local_token]);
                }
                sh_cm_tile[local_token * 16u + dim_local] =
                    float16_t(value);
            }
        } else {
            for (uint i = lane; i < 16u * 64u; i += gl_WorkGroupSize.x) {
                const uint dim_local = i / 64u;
                const uint local_token = i & 63u;
                float value = 0.0;
                const uint dim = dim_base + dim_local;
                if (local_token < tile_tokens && process_body) {
                    const uint token = token_begin + local_token;
                    const uint slice = dim >> 7u;
                    value = load_kvarn(false, logical_head, token, stream,
                        k_live_group, k_live_pos, slice, dim & 127u);
                } else if (local_token < tile_tokens && process_tail) {
                    value = load_tail(false, sh_cm_tail_slot[local_token],
                        logical_head, dim);
                }
                sh_cm_tile[local_token * 16u + dim_local] =
                    float16_t(value);
            }
        }
        barrier();
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> k_mat;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> q_mat;
        coopMatLoad(k_mat, sh_cm_tile, wave * 16u * 16u, 16u,
            gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(q_mat, sh_cm_q_or_p, 0u, 16u,
            gl_CooperativeMatrixLayoutColumnMajor);
        score_mat = coopMatMulAdd(k_mat, q_mat, score_mat);
#ifdef KVAR_COOPMAT_PREFILL
        if (matrix_batches > 1u) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> q_mat_second;
            coopMatLoad(q_mat_second, sh_cm_q_or_p, 64u * 16u, 16u,
                gl_CooperativeMatrixLayoutColumnMajor);
            score_mat_second = coopMatMulAdd(
                k_mat, q_mat_second, score_mat_second);
        }
#if KVAR_COOPMAT_MATRIX_BATCHES > 2
        if (matrix_batches > 2u) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> q_mat_third;
            coopMatLoad(q_mat_third, sh_cm_q_or_p, 2u * 64u * 16u, 16u,
                gl_CooperativeMatrixLayoutColumnMajor);
            score_mat_third = coopMatMulAdd(
                k_mat, q_mat_third, score_mat_third);
        }
#endif
#endif
        barrier();
    }

#ifndef KVAR_COOPMAT_PREFILL
    coopMatStore(score_mat, sh_cm_score_or_pv, wave * 16u * 16u, 16u,
        gl_CooperativeMatrixLayoutRowMajor);
    barrier();
#endif

    // Q is dead after QK. Reuse its storage for the 64x16 FP16 probability
    // matrices consumed by PV.
#ifdef KVAR_COOPMAT_PREFILL
    const uint probability_values = matrix_batches * 64u * 16u;
#else
    const uint probability_values = 64u * 16u;
#endif
    for (uint i = lane; i < probability_values; i += gl_WorkGroupSize.x) {
        sh_cm_q_or_p[i] = float16_t(0.0);
    }
    barrier();

    uint n_head_log2 = 1u;
    while ((n_head_log2 << 1u) <= n_query_heads) {
        n_head_log2 <<= 1u;
    }
    const float m0 = exp2(-p.max_bias / float(n_head_log2));
    const float m1 = exp2(-(p.max_bias / 2.0) / float(n_head_log2));
#ifdef KVAR_COOPMAT_PREFILL
    for (uint matrix_batch = 0u; matrix_batch < matrix_batches; ++matrix_batch) {
        if (matrix_batch == 0u) {
            coopMatStore(score_mat, sh_cm_score_or_pv,
                wave * 16u * 16u, 16u,
                gl_CooperativeMatrixLayoutRowMajor);
        } else if (matrix_batch == 1u) {
            coopMatStore(score_mat_second, sh_cm_score_or_pv,
                wave * 16u * 16u, 16u,
                gl_CooperativeMatrixLayoutRowMajor);
#if KVAR_COOPMAT_MATRIX_BATCHES > 2
        } else {
            coopMatStore(score_mat_third, sh_cm_score_or_pv,
                wave * 16u * 16u, 16u,
                gl_CooperativeMatrixLayoutRowMajor);
#endif
        }
        barrier();
        const uint batch_active_rows = matrix_batch == 0u ? active_rows :
            (matrix_batch == 1u ? second_active_rows : third_active_rows);
        const uint batch_query_base = matrix_batch * queries_per_matrix;
        const uint stats_base = matrix_batch * 16u;
        const uint probability_base = matrix_batch * 64u * 16u;
#else
    const uint batch_active_rows = active_rows;
    const uint batch_query_base = 0u;
    const uint stats_base = 0u;
    const uint probability_base = 0u;
#endif
    for (uint row_base = 0u; row_base < batch_active_rows; row_base += 4u) {
        const uint row = row_base + wave;
        const uint local_token = wave_lane;
        bool enabled = row < batch_active_rows && local_token < tile_tokens;
        float score = -3.402823466e38;
        if (enabled) {
            const uint row_query = query_base() + local_query_base +
                batch_query_base + row / gqa();
            const uint query_head = query_head_first + row % gqa();
            const float slope = p.max_bias > 0.0 ?
                (query_head < n_head_log2 ?
                    pow(m0, float(query_head + 1u)) :
                    pow(m1, float(2u * (query_head - n_head_log2) + 1u))) : 1.0;
            const uint token = token_begin + local_token;
            const float mask_value = process_tail ?
                slope * load_tail_mask(token, row_query, out_stream) :
                ((p.flags & FLAG_MASK) != 0u ?
                    slope * load_mask(token, row_query, out_stream) : 0.0);
            score = sh_cm_score_or_pv[local_token * 16u + row];
            if (p.logit_softcap != 0.0) {
                score = p.logit_softcap * tanh(score);
            }
            score += mask_value;
            enabled = !(isinf(mask_value) && mask_value < 0.0);
        }
        const float maximum = subgroupMax(enabled ? score : -3.402823466e38);
        if (wave_lane == 0u && row < batch_active_rows) {
#ifdef KVAR_COOPMAT_PREFILL
            sh_cm_tile_maximum[stats_base + row] = maximum;
#else
            sh_maximum[row] = maximum;
#endif
        }
        const float weight = enabled && maximum > -3.0e38 ?
            exp(score - maximum) : 0.0;
        if (row < batch_active_rows && local_token < tile_tokens) {
            sh_cm_q_or_p[probability_base + local_token * 16u + row] =
                float16_t(weight);
        }
        const float denominator = subgroupAdd(weight);
        if (wave_lane == 0u && row < batch_active_rows) {
#ifdef KVAR_COOPMAT_PREFILL
            sh_cm_tile_denominator[stats_base + row] = denominator;
#else
            sh_denominator[row] = denominator;
#endif
        }
        barrier();
    }

#ifdef KVAR_COOPMAT_PREFILL
    if (lane < batch_active_rows) {
        const uint stats_index = stats_base + lane;
        const float previous_maximum = sh_maximum[stats_index];
        const float tile_maximum = sh_cm_tile_maximum[stats_index];
        const float next_maximum = max(previous_maximum, tile_maximum);
        const float old_scale = previous_maximum < -3.0e38 ? 0.0 :
            exp(previous_maximum - next_maximum);
        const float tile_scale = tile_maximum < -3.0e38 ? 0.0 :
            exp(tile_maximum - next_maximum);
        sh_cm_old_scale[stats_index] = old_scale;
        sh_cm_tile_scale[stats_index] = tile_scale;
        sh_maximum[stats_index] = next_maximum;
        sh_denominator[stats_index] = sh_denominator[stats_index] * old_scale +
            sh_cm_tile_denominator[stats_index] * tile_scale;
    }
    barrier();
    }
#endif

    for (uint dim_base = 0u; dim_base < head_dim; dim_base += 16u) {
        if (fast_record) {
            // V is token-major, so four adjacent output dimensions share one
            // packed word pair and token scale/zero pair.
            const uint local_token = lane >> 2u;
            const uint dim_local_base = (lane & 3u) * 4u;
            const uint dim = dim_base + dim_local_base;
            const uint slice = dim >> 7u;
            const uint slice_dim = dim & 127u;
            const uint pos = (token_begin + local_token) & 127u;
            const uint record_base = direct_record_base(
                true, stream, body_group, logical_head, slice);
            const uvec4 quant = unpack_record4(true, record_base,
                pos * KVAR_N_DIM + slice_dim, v_bits());
            for (uint j = 0u; j < 4u; ++j) {
                const uint out_dim = dim + j;
                float value = 0.0;
                if (local_token < tile_tokens) {
                    value = (float(quant[j]) *
                                float(sh_cm_token_axes[
                                    (1u * COOPMAT_MAX_HEAD_SLICES + slice) * 64u + local_token]) +
                                float(sh_cm_token_axes[
                                    (2u * COOPMAT_MAX_HEAD_SLICES + slice) * 64u + local_token])) *
                        float(sh_cm_dim_axes[2u * COOPMAT_MAX_HEAD_DIM + out_dim]);
                }
                sh_cm_tile[local_token * 16u + dim_local_base + j] =
                    float16_t(value);
            }
        } else {
            for (uint i = lane; i < 64u * 16u; i += gl_WorkGroupSize.x) {
                const uint local_token = i / 16u;
                const uint dim_local = i & 15u;
                float value = 0.0;
                const uint dim = dim_base + dim_local;
                if (local_token < tile_tokens && process_body) {
                    const uint token = token_begin + local_token;
                    const uint slice = dim >> 7u;
                    value = load_kvarn(true, logical_head, token, stream,
                        v_live_group, v_live_pos, slice, dim & 127u);
                } else if (local_token < tile_tokens && process_tail) {
                    value = load_tail(true, sh_cm_tail_slot[local_token],
                        logical_head, dim);
                }
                sh_cm_tile[local_token * 16u + dim_local] =
                    float16_t(value);
            }
        }
        barrier();

        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> v_mat;
        coopMatLoad(v_mat, sh_cm_tile, wave * 16u * 16u, 16u,
            gl_CooperativeMatrixLayoutRowMajor);
#ifdef KVAR_COOPMAT_PREFILL
        for (uint matrix_batch = 0u; matrix_batch < matrix_batches; ++matrix_batch) {
            const uint batch_active_rows = matrix_batch == 0u ? active_rows :
                (matrix_batch == 1u ? second_active_rows : third_active_rows);
            const uint batch_query_base = matrix_batch * queries_per_matrix;
            const uint stats_base = matrix_batch * 16u;
            const uint probability_base = matrix_batch * 64u * 16u;
#else
        const uint batch_active_rows = active_rows;
        const uint batch_query_base = 0u;
        const uint stats_base = 0u;
        const uint probability_base = 0u;
#endif
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> p_mat;
        coopmat<float, gl_ScopeSubgroup, 16, 16,
            gl_MatrixUseAccumulator> pv_mat =
                coopmat<float, gl_ScopeSubgroup, 16, 16,
                    gl_MatrixUseAccumulator>(0.0);
        coopMatLoad(p_mat, sh_cm_q_or_p,
            probability_base + wave * 16u * 16u, 16u,
            gl_CooperativeMatrixLayoutColumnMajor);
        pv_mat = coopMatMulAdd(p_mat, v_mat, pv_mat);
        coopMatStore(pv_mat, sh_cm_score_or_pv, wave * 16u * 16u, 16u,
            gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        for (uint i = lane; i < batch_active_rows * 16u;
                i += gl_WorkGroupSize.x) {
            const uint row = i / 16u;
            const uint dim_local = i & 15u;
            float value = 0.0;
            for (uint subgroup = 0u; subgroup < 4u; ++subgroup) {
                value += sh_cm_score_or_pv[subgroup * 16u * 16u + row * 16u + dim_local];
            }
#ifdef KVAR_COOPMAT_PREFILL
            const uint accumulator_slot = dim_base / 16u;
            const uint accumulator_index =
                matrix_batch * COOPMAT_DIM_BLOCKS + accumulator_slot;
            accumulator[accumulator_index] =
                accumulator[accumulator_index] * sh_cm_old_scale[stats_base + row] +
                value * sh_cm_tile_scale[stats_base + row];
#else
            const uint row_query_local = local_query_base +
                batch_query_base + row / gqa();
            const uint query_head = query_head_first + row % gqa();
            const uint matrix_base = head_dim * n_query_heads *
                (split_index + split_k *
                    (row_query_local + tile_queries * out_stream)) +
                head_dim * query_head;
            data_dst[matrix_base + dim_base + dim_local] =
                floatBitsToUint(value);
#endif
        }
        barrier();
#ifdef KVAR_COOPMAT_PREFILL
        }
#endif
    }
    }

#ifdef KVAR_COOPMAT_PREFILL
    for (uint matrix_batch = 0u; matrix_batch < matrix_batches; ++matrix_batch) {
        const uint batch_active_rows = matrix_batch == 0u ? active_rows :
            (matrix_batch == 1u ? second_active_rows : third_active_rows);
        const uint batch_query_base = matrix_batch * queries_per_matrix;
        const uint stats_base = matrix_batch * 16u;
        if (lane < batch_active_rows * 16u) {
            const uint row = lane / 16u;
            const uint dim_local = lane & 15u;
            const uint row_query_local = local_query_base +
                batch_query_base + row / gqa();
            const uint query_head = query_head_first + row % gqa();
            const uint matrix_base = head_dim * n_query_heads *
                (split_index + split_k *
                    (row_query_local + tile_queries * out_stream)) +
                head_dim * query_head;
            for (uint dim_base = 0u; dim_base < head_dim; dim_base += 16u) {
                data_dst[matrix_base + dim_base + dim_local] = floatBitsToUint(
                    accumulator[matrix_batch * COOPMAT_DIM_BLOCKS + dim_base / 16u]);
            }
        }
        if (lane < batch_active_rows) {
            const uint row_query_local = local_query_base +
                batch_query_base + lane / gqa();
            const uint query_head = query_head_first + lane % gqa();
            const uint lm_base = matrix_values + n_query_heads * 2u *
                (split_index + split_k *
                    (row_query_local + tile_queries * out_stream));
            data_dst[lm_base + query_head] =
                floatBitsToUint(sh_denominator[stats_base + lane]);
            data_dst[lm_base + n_query_heads + query_head] =
                floatBitsToUint(sh_maximum[stats_base + lane]);
        }
    }
#else
    if (lane < active_rows) {
        const uint row_query_local = local_query_base + lane / gqa();
        const uint query_head = query_head_first + lane % gqa();
        const uint lm_base = matrix_values + n_query_heads * 2u *
            (split_index + split_k *
                (row_query_local + tile_queries * out_stream));
        data_dst[lm_base + query_head] = floatBitsToUint(sh_denominator[lane]);
        data_dst[lm_base + n_query_heads + query_head] =
            floatBitsToUint(sh_maximum[lane]);
    }
#endif
}

#elif defined(KVAR_TILED_WAVE64)

// RDNA3 decode/short-verification route. Four wave64 subgroups evaluate four
// tokens concurrently and share one online-softmax update. This keeps each
// 64-token body/tail split distributed while removing the portable shader's
// cross-wave reduction and per-token workgroup barriers.
const uint KVAR_TILE_TOKENS = 4u;
const uint KVAR_MAX_HEAD_DIM = 512u;
const uint KVAR_DIMS_PER_THREAD = KVAR_MAX_HEAD_DIM / 256u;

shared float sh_value_tile[KVAR_TILE_TOKENS * KVAR_MAX_HEAD_DIM];
shared float sh_score_tile[GQA_GROUP_MAX * KVAR_TILE_TOKENS];
shared float sh_tile_weight[GQA_GROUP_MAX * KVAR_TILE_TOKENS];
shared uint sh_score_enabled[GQA_GROUP_MAX * KVAR_TILE_TOKENS];

void main() {
    // The host only selects this pipeline with a required subgroup size of 64.
    // Keep the guard so an incorrectly created pipeline fails closed instead
    // of indexing the fixed four-token shared-memory tile incorrectly.
    if (gl_NumSubgroups != KVAR_TILE_TOKENS) {
        return;
    }

    const uint lane = gl_LocalInvocationID.x;
    const uint wave = gl_SubgroupID;
    const uint wave_lane = gl_SubgroupInvocationID;
    const uint split_k = max(body_splits() + tail_splits(), 1u);
    const uint split_index = gl_WorkGroupID.x % split_k;
    const uint local_query = gl_WorkGroupID.x / split_k;
    const uint query = query_base() + local_query;
    const uint out_stream = gl_WorkGroupID.z;
    const uint stream = stream_start() + out_stream;
    const uint n_kv_heads = p.n_heads / head_slices();
    const uint n_query_heads = n_kv_heads * gqa();
    const uint gqa_group_size = min(gqa(), GQA_GROUP_MAX);
    const uint gqa_groups = (gqa() + gqa_group_size - 1u) / gqa_group_size;
    const uint logical_head = gl_WorkGroupID.y / gqa_groups;
    const uint gqa_group = gl_WorkGroupID.y % gqa_groups;
    const uint query_head_first = logical_head * gqa() + gqa_group * gqa_group_size;
    const uint active_heads = min(
        gqa_group_size, gqa() - gqa_group * gqa_group_size);
    const bool has_tail = (p.flags & FLAG_TAIL) != 0u;
    const bool bodyless = (p.flags & FLAG_TAIL_BODYLESS) != 0u;
    const uint n_body_splits = body_splits();
    const uint n_tail_splits = tail_splits();
    const bool process_body = !bodyless && split_index < n_body_splits;
    const bool process_tail = has_tail && split_index >= n_body_splits &&
        split_index < n_body_splits + n_tail_splits;

    if (lane == 0u) {
        sh_active = -1;
        if (has_tail) {
            QueryOrderRef query_order = QueryOrderRef(p.query_order_addr);
            const int query_id = int(out_stream * n_query() + query);
            for (uint packed = 0u; packed < p.query_order_nelements; ++packed) {
                if (query_order.data[packed] == query_id) {
                    sh_active = int(packed / query_order_ne0());
                    break;
                }
            }
        }
    }
    barrier();
    if (has_tail && sh_active < 0) {
        return;
    }

    uint k_live_group = 0u;
    uint k_live_pos = 0u;
    uint v_live_group = 0u;
    uint v_live_pos = 0u;
    if (!bodyless) {
#ifdef KVAR_PRECOMPUTED_LIVE
        const uint k_live_base = 2u * out_stream;
        const uint v_live_base = (p.flags & FLAG_SHARED_INDICES) != 0u ?
            k_live_base : 2u * gl_NumWorkGroups.z + k_live_base;
        k_live_group = data_live[k_live_base + 0u];
        k_live_pos = data_live[k_live_base + 1u];
        v_live_group = data_live[v_live_base + 0u];
        v_live_pos = data_live[v_live_base + 1u];
#else
        compute_live(false, stream, lane, k_live_group, k_live_pos);
        if ((p.flags & FLAG_SHARED_INDICES) != 0u) {
            v_live_group = k_live_group;
            v_live_pos = k_live_pos;
        } else {
            compute_live(true, stream, lane, v_live_group, v_live_pos);
        }
#endif
    }

    const uint head_dim = head_slices() * KVAR_N_DIM;
    float accumulator[GQA_GROUP_MAX * KVAR_DIMS_PER_THREAD];
    for (uint i = 0u; i < GQA_GROUP_MAX * KVAR_DIMS_PER_THREAD; ++i) {
        accumulator[i] = 0.0;
    }
    if (lane == 0u) {
        for (uint gi = 0u; gi < active_heads; ++gi) {
            sh_maximum[gi] = -3.402823466e38;
            sh_denominator[gi] = 0.0;
        }
    }

    uint n_head_log2 = 1u;
    while ((n_head_log2 << 1u) <= n_query_heads) {
        n_head_log2 <<= 1u;
    }
    const float m0 = exp2(-p.max_bias / float(n_head_log2));
    const float m1 = exp2(-(p.max_bias / 2.0) / float(n_head_log2));
    float slopes[GQA_GROUP_MAX];
    uint q_bases[GQA_GROUP_MAX];
    float q_wave_values[GQA_GROUP_MAX * 8u];
    for (uint gi = 0u; gi < active_heads; ++gi) {
        const uint query_head = query_head_first + gi;
        slopes[gi] = p.max_bias > 0.0 ?
            (query_head < n_head_log2 ?
                pow(m0, float(query_head + 1u)) :
                pow(m1, float(2u * (query_head - n_head_log2) + 1u))) : 1.0;
        q_bases[gi] = query * q_nb1() + query_head * q_nb2() +
            out_stream * head_dim * n_query() * n_query_heads;
        for (uint dim = wave_lane; dim < head_dim; dim += 64u) {
            q_wave_values[gi * 8u + dim / 64u] =
                uintBitsToFloat(data_q[q_bases[gi] + dim]);
        }
    }
    barrier();

    const uint body_tokens = bodyless ? 0u : p.n_kv;
    const uint body_divisor = max(n_body_splits, 1u);
    const bool small_query = n_query() <= 8u;
    uint token_begin = 0u;
    uint token_end = 0u;
    if (process_body) {
        token_begin = small_query ? split_index * 64u :
            body_tokens * split_index / body_divisor;
        token_end = small_query ? min(token_begin + 64u, body_tokens) :
            body_tokens * (split_index + 1u) / body_divisor;
    } else if (process_tail) {
        RunDescRef run_desc = RunDescRef(p.run_desc_addr);
        const uint desc_base = uint(sh_active) * p.run_desc_ne0;
        const uint n_tail = uint(max(run_desc.data[desc_base + 4u], 0));
        const uint tail_split = split_index - n_body_splits;
        token_begin = tail_split * 64u;
        token_end = min(token_begin + 64u, n_tail);
    }

    const uint fast_group = token_begin / KVAR_N_DIM;
    const bool fast_record = process_body && token_begin < token_end &&
        token_end <= (fast_group + 1u) * KVAR_N_DIM &&
        direct_body_record_available(false, fast_group, k_live_group, k_live_pos) &&
        direct_body_record_available(true, fast_group, v_live_group, v_live_pos);
    uint k_record_bases[4];
    uint v_record_bases[4];
    for (uint slice = 0u; slice < head_slices(); ++slice) {
        k_record_bases[slice] = direct_record_base(
            false, stream, fast_group, logical_head, slice);
        v_record_bases[slice] = direct_record_base(
            true, stream, fast_group, logical_head, slice);
    }
    float k_axis_scale[8];
    float k_axis_zero[8];
    float v_axis_other[8];
    if (fast_record) {
        for (uint dim = wave_lane; dim < head_dim; dim += 64u) {
            const uint slice = dim >> 7u;
            const uint slice_dim = dim & 127u;
            const uint dim_slot = dim / 64u;
            k_axis_scale[dim_slot] = load_axis(
                false, k_record_bases[slice], k_bits() * 512u, 0u, slice_dim);
            k_axis_zero[dim_slot] = load_axis(
                false, k_record_bases[slice], k_bits() * 512u, 1u, slice_dim);
            v_axis_other[dim_slot] = load_axis(
                true, v_record_bases[slice], v_bits() * 512u, 2u, slice_dim);
        }
    }

    for (uint tile_begin = token_begin; tile_begin < token_end;
            tile_begin += KVAR_TILE_TOKENS) {
        const uint token = tile_begin + wave;
        const bool token_valid = token < token_end;
        uint tail_slot = 0u;
        if (process_tail && token_valid) {
            RunDescRef run_desc = RunDescRef(p.run_desc_addr);
            const uint desc_base = uint(sh_active) * p.run_desc_ne0;
            tail_slot = uint(run_desc.data[desc_base + 6u + token]);
        }

        if (fast_record) {
            if (wave_lane == 0u) {
                const uint pos = token & 127u;
                for (uint slice = 0u; slice < head_slices(); ++slice) {
                    const uint axis_base = (wave * 4u + slice) * 3u;
                    sh_record_token_axes[axis_base + 0u] = load_axis(
                        false, k_record_bases[slice], k_bits() * 512u, 2u, pos);
                    sh_record_token_axes[axis_base + 1u] = load_axis(
                        true, v_record_bases[slice], v_bits() * 512u, 0u, pos);
                    sh_record_token_axes[axis_base + 2u] = load_axis(
                        true, v_record_bases[slice], v_bits() * 512u, 1u, pos);
                }
            }
            barrier();
        }

        float score_partial[GQA_GROUP_MAX];
        for (uint gi = 0u; gi < GQA_GROUP_MAX; ++gi) {
            score_partial[gi] = 0.0;
        }
        for (uint dim = wave_lane; dim < head_dim; dim += 64u) {
            float kval = 0.0;
            float vval = 0.0;
            if (token_valid) {
                if (fast_record) {
                    const uint slice = dim >> 7u;
                    const uint slice_dim = dim & 127u;
                    const uint dim_slot = dim / 64u;
                    const uint pos = token & 127u;
                    const uint axis_base = (wave * 4u + slice) * 3u;
                    const uint k_quant = unpack_record(
                        false, k_record_bases[slice],
                        slice_dim * KVAR_N_DIM + pos, k_bits());
                    const uint v_quant = unpack_record(
                        true, v_record_bases[slice],
                        pos * KVAR_N_DIM + slice_dim, v_bits());
                    kval = (float(k_quant) * k_axis_scale[dim_slot] +
                        k_axis_zero[dim_slot]) *
                        sh_record_token_axes[axis_base + 0u];
                    vval = (float(v_quant) *
                        sh_record_token_axes[axis_base + 1u] +
                        sh_record_token_axes[axis_base + 2u]) *
                        v_axis_other[dim_slot];
                } else if (process_body) {
                    const uint slice = dim >> 7u;
                    const uint slice_dim = dim & 127u;
                    kval = load_kvarn(false, logical_head, token, stream,
                        k_live_group, k_live_pos, slice, slice_dim);
                    vval = load_kvarn(true, logical_head, token, stream,
                        v_live_group, v_live_pos, slice, slice_dim);
                } else if (process_tail) {
                    kval = load_tail(false, tail_slot, logical_head, dim);
                    vval = load_tail(true, tail_slot, logical_head, dim);
                }
            }
            sh_value_tile[wave * KVAR_MAX_HEAD_DIM + dim] = vval;
            for (uint gi = 0u; gi < active_heads; ++gi) {
                score_partial[gi] +=
                    q_wave_values[gi * 8u + dim / 64u] * kval;
            }
        }

        for (uint gi = 0u; gi < active_heads; ++gi) {
            const float total = subgroupAdd(score_partial[gi]);
            if (wave_lane == 0u) {
                float mask_value = 0.0;
                if (token_valid) {
                    mask_value = process_tail ?
                        slopes[gi] * load_tail_mask(token, query, out_stream) :
                        ((p.flags & FLAG_MASK) != 0u ?
                            slopes[gi] * load_mask(token, query, out_stream) : 0.0);
                }
                float score = total * p.scale;
                if (p.logit_softcap != 0.0) {
                    score = p.logit_softcap * tanh(score);
                }
                score += mask_value;
                const uint score_index = gi * KVAR_TILE_TOKENS + wave;
                sh_score_tile[score_index] = score;
                sh_score_enabled[score_index] = token_valid &&
                    !(isinf(mask_value) && mask_value < 0.0) ? 1u : 0u;
            }
        }
        barrier();

        if (lane == 0u) {
            for (uint gi = 0u; gi < active_heads; ++gi) {
                float next_maximum = sh_maximum[gi];
                for (uint ti = 0u; ti < KVAR_TILE_TOKENS; ++ti) {
                    const uint si = gi * KVAR_TILE_TOKENS + ti;
                    if (sh_score_enabled[si] != 0u) {
                        next_maximum = max(next_maximum, sh_score_tile[si]);
                    }
                }
                const float old_scale = sh_maximum[gi] < -3.0e38 ?
                    0.0 : exp(sh_maximum[gi] - next_maximum);
                float denominator = sh_denominator[gi] * old_scale;
                for (uint ti = 0u; ti < KVAR_TILE_TOKENS; ++ti) {
                    const uint si = gi * KVAR_TILE_TOKENS + ti;
                    const float weight = sh_score_enabled[si] != 0u ?
                        exp(sh_score_tile[si] - next_maximum) : 0.0;
                    sh_tile_weight[si] = weight;
                    denominator += weight;
                }
                sh_old_scale[gi] = old_scale;
                sh_maximum[gi] = next_maximum;
                sh_denominator[gi] = denominator;
            }
        }
        barrier();

        for (uint dim = lane; dim < head_dim; dim += 256u) {
            const uint dim_slot = dim / 256u;
            for (uint gi = 0u; gi < active_heads; ++gi) {
                float update = 0.0;
                for (uint ti = 0u; ti < KVAR_TILE_TOKENS; ++ti) {
                    update += sh_value_tile[ti * KVAR_MAX_HEAD_DIM + dim] *
                        sh_tile_weight[gi * KVAR_TILE_TOKENS + ti];
                }
                const uint ai = gi * KVAR_DIMS_PER_THREAD + dim_slot;
                accumulator[ai] = accumulator[ai] * sh_old_scale[gi] + update;
            }
        }
        barrier();
    }

    if (split_k > 1u) {
        const uint tile_queries = gl_NumWorkGroups.x / split_k;
        const uint matrix_values = head_dim * tile_queries * n_query_heads *
            gl_NumWorkGroups.z * split_k;
        for (uint gi = 0u; gi < active_heads; ++gi) {
            const uint query_head = query_head_first + gi;
            const uint matrix_base = head_dim * n_query_heads *
                (split_index + split_k * (local_query + tile_queries * out_stream)) +
                head_dim * query_head;
            for (uint dim = lane; dim < head_dim; dim += 256u) {
                const uint ai = gi * KVAR_DIMS_PER_THREAD + dim / 256u;
                data_dst[matrix_base + dim] = floatBitsToUint(accumulator[ai]);
            }
            if (lane == 0u) {
                const uint lm_base = matrix_values + n_query_heads * 2u *
                    (split_index + split_k * (local_query + tile_queries * out_stream));
                data_dst[lm_base + query_head] = floatBitsToUint(sh_denominator[gi]);
                data_dst[lm_base + n_query_heads + query_head] = floatBitsToUint(sh_maximum[gi]);
            }
        }
        return;
    }

    if (lane == 0u) {
        for (uint gi = 0u; gi < active_heads; ++gi) {
            const uint query_head = query_head_first + gi;
            if ((p.flags & FLAG_SINKS) != 0u) {
                const float score = uintBitsToFloat(data_sinks[query_head]);
                const float next_maximum = max(sh_maximum[gi], score);
                sh_old_scale[gi] = sh_maximum[gi] < -3.0e38 ?
                    0.0 : exp(sh_maximum[gi] - next_maximum);
                sh_denominator[gi] = sh_denominator[gi] * sh_old_scale[gi] +
                    exp(score - next_maximum);
                sh_maximum[gi] = next_maximum;
            } else {
                sh_old_scale[gi] = 1.0;
            }
            sh_weight[gi] = sh_denominator[gi] > 0.0 ?
                1.0 / sh_denominator[gi] : 0.0;
        }
    }
    barrier();

    for (uint gi = 0u; gi < active_heads; ++gi) {
        const uint query_head = query_head_first + gi;
        const uint dst_base = query_head * head_dim +
            query * head_dim * n_query_heads +
            out_stream * head_dim * n_query_heads * n_query();
        for (uint dim = lane; dim < head_dim; dim += 256u) {
            const uint ai = gi * KVAR_DIMS_PER_THREAD + dim / 256u;
            data_dst[dst_base + dim] = floatBitsToUint(
                accumulator[ai] * sh_old_scale[gi] * sh_weight[gi]);
        }
    }
}

