    const uint lane = gl_LocalInvocationID.x;
    const uint split_k = max(body_splits() + tail_splits(), 1u);
    const bool tail_only_dispatch = dispatch_mode() == 2u;
    const uint dispatch_splits = tail_only_dispatch ?
        max(tail_splits(), 1u) : split_k;
