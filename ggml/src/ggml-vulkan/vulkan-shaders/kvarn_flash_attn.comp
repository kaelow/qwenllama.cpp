const uint KVAR_N_DIM = 128u;
const uint FLAG_SWA = 1u;
const uint FLAG_EAGER = 2u;
const uint FLAG_MASK = 4u;
const uint FLAG_SINKS = 8u;
const uint FLAG_TAIL = 16u;
const uint FLAG_K_TAIL_BF16 = 32u;
const uint FLAG_V_TAIL_BF16 = 64u;
const uint FLAG_SHARED_INDICES = 128u;
const uint FLAG_TAIL_CURRENT = 256u;
const uint FLAG_TAIL_BODYLESS = 512u;
const uint FLAG_TAIL_HISTORY_SHIFT = 10u;
#ifndef KVAR_GQA_GROUP_MAX
#define KVAR_GQA_GROUP_MAX 4
#endif
#ifndef KVAR_COOPMAT_DIM_BLOCKS
#define KVAR_COOPMAT_DIM_BLOCKS 32
#endif
const uint GQA_GROUP_MAX = uint(KVAR_GQA_GROUP_MAX);
const uint COOPMAT_DIM_BLOCKS = uint(KVAR_COOPMAT_DIM_BLOCKS);
const uint COOPMAT_MATRIX_BATCHES = uint(KVAR_COOPMAT_MATRIX_BATCHES);
const uint COOPMAT_MAX_HEAD_DIM = uint(KVAR_COOPMAT_MAX_HEAD_DIM);
const uint COOPMAT_MAX_HEAD_SLICES = uint(KVAR_COOPMAT_MAX_HEAD_SLICES);

uint k_bits() {
    return p.bits_packed & 0x0fu;
}

uint v_bits() {
    return (p.bits_packed >> 4u) & 0x0fu;
}

uint body_splits() {
    return (p.bits_packed >> 8u) & 0xffffu;
}

uint tail_splits() {
    return p.bits_packed >> 24u;
}

uint tail_stride() {
    return p.tail_stride & 0xffffu;
}

uint query_base() {
    return p.tail_stride >> 16u;
}

uint head_slices() {
    return p.kvarn_shape_packed & 0xffu;
}

uint stage_groups() {
    return (p.kvarn_shape_packed >> 8u) & 0xffu;
}

uint tail_groups() {
    return (p.kvarn_shape_packed >> 16u) & 0xffu;
}

bool read_indirect() {
    return ((p.kvarn_shape_packed >> 24u) & 1u) != 0u;
}

uint dispatch_mode() {
    return (p.kvarn_shape_packed >> 25u) & 3u;
}

uint mask_ne3() {
    return p.mask_query_packed & 0xffffu;
}

uint query_order_ne0() {
    return p.mask_query_packed >> 16u;
}

uint n_query() {
    return p.query_shape_packed & 0xffffu;
}

uint gqa() {
    return p.query_shape_packed >> 16u;
}

uint cooperative_query_pack() {
    const uint encoded = (p.kvarn_shape_packed >> 27u) & 0x1fu;
    return encoded == 0u ? max(1u, 16u / gqa()) : encoded;
}

uint q_nb1() {
    return p.q_nb1;
}

uint q_nb2() {
    return p.q_nb2;
}

uint stream_start() {
    return p.stream_group_packed & 0xffffu;
}

uint groups_per_stream() {
    return p.stream_group_packed >> 16u;
}

