#endif
shared float sh_maximum[GQA_GROUP_MAX];
shared float sh_denominator[GQA_GROUP_MAX];
shared float sh_old_scale[GQA_GROUP_MAX];
shared float sh_weight[GQA_GROUP_MAX];
shared int sh_active;
shared float sh_record_token_axes[8u * 4u * 3u];
#else
#ifdef KVAR_COOPMAT_PREFILL
shared float sh_maximum[KVAR_COOPMAT_MATRIX_BATCHES * KVAR_GQA_GROUP_MAX];
shared float sh_denominator[KVAR_COOPMAT_MATRIX_BATCHES * KVAR_GQA_GROUP_MAX];
#else
