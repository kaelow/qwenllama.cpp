#ifdef KVAR_COOPMAT
// One workgroup owns one 64-token split and one KV head.  Query rows are the
// GQA heads (padded to the native 16x16x16 KHR cooperative-matrix shape).
// Stage only the current 16-wide query slice instead of a full D512 matrix;
// after QK the same allocation holds the 64x16 probability tile. Prefill has
// several probability planes so one reconstructed K/V tile can serve several
// matrix batches. Scores and PV products are lifetime-disjoint and share one FP32
// matrix. Keeping D256 LDS below 16 KiB is important on RDNA3's 32 KiB
// workgroup-memory devices: it permits two resident workgroups per CU.
#ifdef KVAR_COOPMAT_PREFILL
shared float16_t sh_cm_q_or_p[KVAR_COOPMAT_MATRIX_BATCHES * 64 * 16];
#else
shared float16_t sh_cm_q_or_p[64u * 16u];
#endif
shared float16_t sh_cm_tile[64u * 16u];
shared float sh_cm_score_or_pv[4u * 16u * 16u];
shared float16_t sh_cm_dim_axes[3 * KVAR_COOPMAT_MAX_HEAD_DIM];
shared float16_t sh_cm_token_axes[3 * KVAR_COOPMAT_MAX_HEAD_SLICES * 64];
shared uint sh_cm_tail_slot[64u];
#ifdef KVAR_COOPMAT_PREFILL
shared float sh_cm_tile_maximum[KVAR_COOPMAT_MATRIX_BATCHES * 16];
shared float sh_cm_tile_denominator[KVAR_COOPMAT_MATRIX_BATCHES * 16];
shared float sh_cm_old_scale[KVAR_COOPMAT_MATRIX_BATCHES * 16];
shared float sh_cm_tile_scale[KVAR_COOPMAT_MATRIX_BATCHES * 16];
#endif
#endif

