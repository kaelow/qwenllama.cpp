        n_head_log2 <<= 1u;
    }
    const float m0 = exp2(-p.max_bias / float(n_head_log2));
    const float m1 = exp2(-(p.max_bias / 2.0) / float(n_head_log2));
    const uint head_dim = head_slices() * KVAR_N_DIM;
    float slopes[GQA_GROUP_MAX];
    uint q_bases[GQA_GROUP_MAX];
    float q_values[GQA_GROUP_MAX * 4u];
    for (uint gi = 0u; gi < active_heads; ++gi) {
        const uint query_head = query_head_first + gi;
        slopes[gi] = p.max_bias > 0.0 ?
            (query_head < n_head_log2 ?
                pow(m0, float(query_head + 1u)) :
                pow(m1, float(2u * (query_head - n_head_log2) + 1u))) : 1.0;
        q_bases[gi] = query * q_nb1() +
            query_head * q_nb2() +
            out_stream * head_dim * n_query() * n_query_heads;
        for (uint slice = 0u; slice < head_slices(); ++slice) {
            const uint dim = slice * KVAR_N_DIM + lane;
            q_values[gi * 4u + slice] =
                uintBitsToFloat(data_q[q_bases[gi] + dim]);
        }
    }

    const uint body_tokens = bodyless ? 0u : p.n_kv;
    const uint body_divisor = max(n_body_splits, 1u);
    const bool small_query = n_query() <= 8u;
    const uint body_tiles = (body_tokens + 63u) / 64u;
    const uint token_begin = process_body ? (small_query ?
        (body_tiles * split_index / body_divisor) * 64u :
        body_tokens * split_index / body_divisor) : 0u;
    const uint token_end = process_body ? (small_query ?
        min((body_tiles * (split_index + 1u) / body_divisor) * 64u,
            body_tokens) :
        body_tokens * (split_index + 1u) / body_divisor) : 0u;

    bool record_tile_done = false;
#ifdef KVAR_RECORD_TILE
    // Decode/short verification: stage the packed record with coalesced loads,
    // evaluate two tokens concurrently (one per wave64), normalize the whole
    // 64-token block, then reuse LDS for V.  The split reducer still performs
    // the global softmax across body and exact-tail partials.
    const uint tile_group = token_begin / KVAR_N_DIM;
    const bool record_tile = process_body && small_query &&
        token_begin < token_end && token_end - token_begin <= 64u &&
        token_end <= (tile_group + 1u) * KVAR_N_DIM &&
        direct_body_record_available(false, tile_group, k_live_group, k_live_pos) &&
        direct_body_record_available(true, tile_group, v_live_group, v_live_pos);
    if (record_tile) {
        const uint tile_tokens = token_end - token_begin;
        for (uint i = lane; i < GQA_GROUP_MAX * 64u;
                i += gl_WorkGroupSize.x) {
            sh_block_score[i] = 0.0;
            sh_block_weight[i] = 0.0;
            sh_block_enabled[i] = 0u;
        }
        barrier();

        const uint wave = gl_SubgroupID;
        const uint wave_lane = gl_SubgroupInvocationID;
        for (uint slice = 0u; slice < head_slices(); ++slice) {
            const uint record_base = direct_record_base(
                false, stream, tile_group, logical_head, slice);
            const uint bits = k_bits();
            const uint payload_words = bits * 512u;
            cache_record(false, record_base, payload_words + 192u, lane);

            float q_lo[GQA_GROUP_MAX];
            float q_hi[GQA_GROUP_MAX];
            for (uint gi = 0u; gi < active_heads; ++gi) {
                q_lo[gi] = uintBitsToFloat(data_q[
                    q_bases[gi] + slice * KVAR_N_DIM + wave_lane]);
                q_hi[gi] = uintBitsToFloat(data_q[
                    q_bases[gi] + slice * KVAR_N_DIM + wave_lane + 64u]);
            }
            const float k_scale_lo = load_cached_axis(
                payload_words, 0u, wave_lane);
            const float k_zero_lo = load_cached_axis(
                payload_words, 1u, wave_lane);
            const float k_scale_hi = load_cached_axis(
                payload_words, 0u, wave_lane + 64u);
            const float k_zero_hi = load_cached_axis(
                payload_words, 1u, wave_lane + 64u);

            for (uint local_base = 0u; local_base < tile_tokens;
                    local_base += gl_NumSubgroups) {
                const uint local_token = local_base + wave;
                if (local_token < tile_tokens) {
                    const uint pos = (token_begin + local_token) & 127u;
                    const float k_other = load_cached_axis(
                        payload_words, 2u, pos);
                    const uint q_lo_bits = unpack_cached_record(
                        wave_lane * KVAR_N_DIM + pos, bits);
                    const uint q_hi_bits = unpack_cached_record(
                        (wave_lane + 64u) * KVAR_N_DIM + pos, bits);
                    const float kval_lo =
                        (float(q_lo_bits) * k_scale_lo + k_zero_lo) * k_other;
                    const float kval_hi =
                        (float(q_hi_bits) * k_scale_hi + k_zero_hi) * k_other;
                    for (uint gi = 0u; gi < active_heads; ++gi) {
                        const float partial = subgroupAdd(
                            q_lo[gi] * kval_lo + q_hi[gi] * kval_hi);
                        if (wave_lane == 0u) {
                            sh_block_score[gi * 64u + local_token] += partial;
                        }
                    }
                }
            }
            barrier();
        }

        // Apply score transforms and obtain one local softmax for this split.
        for (uint gi = 0u; gi < active_heads; ++gi) {
            float score = -3.402823466e38;
            bool enabled = false;
            if (lane < tile_tokens) {
                const uint token = token_begin + lane;
                const float mask_value = (p.flags & FLAG_MASK) != 0u ?
                    slopes[gi] * load_mask(token, query, out_stream) : 0.0;
                score = sh_block_score[gi * 64u + lane] * p.scale;
                if (p.logit_softcap != 0.0) {
                    score = p.logit_softcap * tanh(score);
                }
                score += mask_value;
                enabled = !(isinf(mask_value) && mask_value < 0.0);
                sh_block_score[gi * 64u + lane] = score;
                sh_block_enabled[gi * 64u + lane] = enabled ? 1u : 0u;
            }
            const float local_max = subgroupMax(enabled ? score : -3.402823466e38);
            if (lane == 0u) {
                sh_maximum[gi] = local_max;
            }
            barrier();

            float weight = 0.0;
            if (lane < tile_tokens && enabled &&
                    sh_maximum[gi] > -3.0e38) {
                weight = exp(score - sh_maximum[gi]);
                sh_block_weight[gi * 64u + lane] = weight;
            }
            const float local_sum = subgroupAdd(weight);
            if (lane == 0u) {
                sh_denominator[gi] = local_sum;
            }
            barrier();
        }

        // V is token-major in a KVarN record.  Once cached, every lane owns one
        // output dimension and reuses each dequantized value across all GQA
        // heads without cross-wave reductions.
        for (uint slice = 0u; slice < head_slices(); ++slice) {
            const uint record_base = direct_record_base(
                true, stream, tile_group, logical_head, slice);
            const uint bits = v_bits();
            const uint payload_words = bits * 512u;
            cache_record(true, record_base, payload_words + 192u, lane);
            const float v_other = load_cached_axis(payload_words, 2u, lane);
            for (uint local_token = 0u; local_token < tile_tokens; ++local_token) {
                const uint pos = (token_begin + local_token) & 127u;
                const uint quant = unpack_cached_record(
                    pos * KVAR_N_DIM + lane, bits);
                const float value =
                    (float(quant) * load_cached_axis(payload_words, 0u, pos) +
                        load_cached_axis(payload_words, 1u, pos)) * v_other;
                for (uint gi = 0u; gi < active_heads; ++gi) {
                    const uint acc = gi * 4u + slice;
                    accumulator[acc] += value *
                        sh_block_weight[gi * 64u + local_token];
                }
            }
            barrier();
        }
        record_tile_done = true;
    }
#endif

    // A split can span several records.  Walk it one record at a time so each
    // sealed record retains the fast path. Partial-record/staged/indirect ranges
    // use the portable loader.
    uint token_cursor = token_begin;
    while (!record_tile_done && token_cursor < token_end) {
        const uint fast_group = token_cursor / KVAR_N_DIM;
        const uint record_end = min(token_end, (fast_group + 1u) * KVAR_N_DIM);
        const bool fast_record =
            direct_body_record_available(false, fast_group, k_live_group, k_live_pos) &&
            direct_body_record_available(true, fast_group, v_live_group, v_live_pos);
        uint k_record_bases[4];
        uint v_record_bases[4];
        float k_axis_scale[4];
        float k_axis_zero[4];
        float v_axis_other[4];
        for (uint slice = 0u; slice < head_slices(); ++slice) {
            const uint k_base = direct_record_base(
                false, stream, fast_group, logical_head, slice);
            const uint v_base = direct_record_base(
                true, stream, fast_group, logical_head, slice);
            k_record_bases[slice] = k_base;
            v_record_bases[slice] = v_base;
            if (fast_record) {
                k_axis_scale[slice] = load_axis(
                    false, k_base, k_bits() * 512u, 0u, lane);
                k_axis_zero[slice] = load_axis(
                    false, k_base, k_bits() * 512u, 1u, lane);
                v_axis_other[slice] = load_axis(
                    true, v_base, v_bits() * 512u, 2u, lane);
            }
        }

        for (uint token = token_cursor; token < record_end; ++token) {
        float k_values[4];
        float v_values[4];
        if (fast_record) {
            const uint pos = token & 127u;
            if (gl_SubgroupInvocationID == 0u) {
                for (uint slice = 0u; slice < head_slices(); ++slice) {
                    const uint k_base = k_record_bases[slice];
                    const uint v_base = v_record_bases[slice];
                    const uint axis_base = (gl_SubgroupID * 4u + slice) * 3u;
                    sh_record_token_axes[axis_base + 0u] = load_axis(
                        false, k_base, k_bits() * 512u, 2u, pos);
                    sh_record_token_axes[axis_base + 1u] = load_axis(
                        true, v_base, v_bits() * 512u, 0u, pos);
                    sh_record_token_axes[axis_base + 2u] = load_axis(
                        true, v_base, v_bits() * 512u, 1u, pos);
                }
            }
            barrier();
            for (uint slice = 0u; slice < head_slices(); ++slice) {
                const uint k_base = k_record_bases[slice];
                const uint v_base = v_record_bases[slice];
                const uint axis_base = (gl_SubgroupID * 4u + slice) * 3u;
                const float k_other = sh_record_token_axes[axis_base + 0u];
                const float v_scale = sh_record_token_axes[axis_base + 1u];
                const float v_zero = sh_record_token_axes[axis_base + 2u];
                const uint k_quant = unpack_record(
                    false, k_base, lane * KVAR_N_DIM + pos, k_bits());
                const uint v_quant = unpack_record(
                    true, v_base, pos * KVAR_N_DIM + lane, v_bits());
                k_values[slice] =
                    (float(k_quant) * k_axis_scale[slice] + k_axis_zero[slice]) *
                    k_other;
                v_values[slice] =
                    (float(v_quant) * v_scale + v_zero) * v_axis_other[slice];
            }
        } else {
            for (uint slice = 0u; slice < head_slices(); ++slice) {
                k_values[slice] = load_kvarn(false, logical_head, token, stream,
                    k_live_group, k_live_pos, slice, lane);
                v_values[slice] = load_kvarn(true, logical_head, token, stream,
                    v_live_group, v_live_pos, slice, lane);
            }
        }

        for (uint gi = 0u; gi < active_heads; ++gi) {
            float partial = 0.0;
            for (uint slice = 0u; slice < head_slices(); ++slice) {
                const uint dim = slice * KVAR_N_DIM + lane;
                partial += q_values[gi * 4u + slice] * k_values[slice];
            }
            partial = subgroupAdd(partial);
            if (gl_SubgroupInvocationID == 0u) {
                sh_reduce[gi * 8u + gl_SubgroupID] = partial;
            }
        }
        barrier();
        if (lane == 0u) {
            for (uint gi = 0u; gi < active_heads; ++gi) {
                float total = 0.0;
                for (uint subgroup = 0u; subgroup < gl_NumSubgroups; ++subgroup) {
                    total += sh_reduce[gi * 8u + subgroup];
                }
                const float mask_value = (p.flags & FLAG_MASK) != 0u ?
                    slopes[gi] * load_mask(token, query, out_stream) : 0.0;
                float score = total * p.scale;
                if (p.logit_softcap != 0.0) {
                    score = p.logit_softcap * tanh(score);
                }
                score += mask_value;
                if (isinf(mask_value) && mask_value < 0.0) {
                    sh_old_scale[gi] = 1.0;
                    sh_weight[gi] = 0.0;
                } else {
                    const float next_maximum = max(sh_maximum[gi], score);
                    const float old_scale = sh_maximum[gi] < -3.0e38 ?
                        0.0 : exp(sh_maximum[gi] - next_maximum);
                    const float weight = exp(score - next_maximum);
                    sh_maximum[gi] = next_maximum;
                    sh_denominator[gi] = sh_denominator[gi] * old_scale + weight;
                    sh_old_scale[gi] = old_scale;
                    sh_weight[gi] = weight;
                }
            }
        }
        barrier();
            for (uint gi = 0u; gi < active_heads; ++gi) {
                for (uint slice = 0u; slice < head_slices(); ++slice) {
                    const uint acc = gi * 4u + slice;
                    accumulator[acc] = accumulator[acc] * sh_old_scale[gi] +
                        v_values[slice] * sh_weight[gi];
                }
            }
        }
        token_cursor = record_end;
    }

    if (process_tail) {
        RunDescRef run_desc = RunDescRef(p.run_desc_addr);
        const uint desc_base = uint(sh_active) * p.run_desc_ne0;
        const uint n_tail = uint(max(run_desc.data[desc_base + 4u], 0));
        const uint tail_split = split_index - n_body_splits;
        const uint tail_begin = tail_split * 64u;
        const uint tail_end = min(tail_begin + 64u, n_tail);
        for (uint token = tail_begin; token < tail_end; ++token) {
            const uint slot = uint(run_desc.data[desc_base + 6u + token]);
            float k_values[4];
            float v_values[4];
            for (uint slice = 0u; slice < head_slices(); ++slice) {
                const uint dim = slice * KVAR_N_DIM + lane;
                k_values[slice] = load_tail(false, slot, logical_head, dim);
                v_values[slice] = load_tail(true, slot, logical_head, dim);
            }

            for (uint gi = 0u; gi < active_heads; ++gi) {
                float partial = 0.0;
                for (uint slice = 0u; slice < head_slices(); ++slice) {
                    const uint dim = slice * KVAR_N_DIM + lane;
                    partial += q_values[gi * 4u + slice] * k_values[slice];
                }
                partial = subgroupAdd(partial);
                if (gl_SubgroupInvocationID == 0u) {
                    sh_reduce[gi * 8u + gl_SubgroupID] = partial;
                }
            }
            barrier();
            if (lane == 0u) {
                for (uint gi = 0u; gi < active_heads; ++gi) {
                    float total = 0.0;
                    for (uint subgroup = 0u; subgroup < gl_NumSubgroups; ++subgroup) {
                        total += sh_reduce[gi * 8u + subgroup];
                    }
                    const float mask_value =
                        slopes[gi] * load_tail_mask(token, query, out_stream);
                    float score = total * p.scale;
                    if (p.logit_softcap != 0.0) {
                        score = p.logit_softcap * tanh(score);
                    }
                    score += mask_value;
                    if (isinf(mask_value) && mask_value < 0.0) {
                        sh_old_scale[gi] = 1.0;
                        sh_weight[gi] = 0.0;
                    } else {
                        const float next_maximum = max(sh_maximum[gi], score);
                        const float old_scale = sh_maximum[gi] < -3.0e38 ?
                            0.0 : exp(sh_maximum[gi] - next_maximum);
                        const float weight = exp(score - next_maximum);
                        sh_maximum[gi] = next_maximum;
                        sh_denominator[gi] = sh_denominator[gi] * old_scale + weight;
                        sh_old_scale[gi] = old_scale;
                        sh_weight[gi] = weight;
                    }
                }
            }
            barrier();
            for (uint gi = 0u; gi < active_heads; ++gi) {
                for (uint slice = 0u; slice < head_slices(); ++slice) {
                    const uint acc = gi * 4u + slice;
                    accumulator[acc] = accumulator[acc] * sh_old_scale[gi] +
                        v_values[slice] * sh_weight[gi];
                }
            }
        }
    }

    if (split_k > 1u) {
        const uint tile_queries = gl_NumWorkGroups.x / dispatch_splits;
        const uint matrix_values = head_dim * tile_queries * n_query_heads *
            gl_NumWorkGroups.z * split_k;
        for (uint gi = 0u; gi < active_heads; ++gi) {
            const uint query_head = query_head_first + gi;
            const uint matrix_base = head_dim * n_query_heads *
                (split_index + split_k * (local_query + tile_queries * out_stream)) +
                head_dim * query_head;
            for (uint slice = 0u; slice < head_slices(); ++slice) {
                const uint dim = slice * KVAR_N_DIM + lane;
                data_dst[matrix_base + dim] = floatBitsToUint(accumulator[gi * 4u + slice]);
            }
            if (lane == 0u) {
                const uint lm_base = matrix_values + n_query_heads * 2u *
                    (split_index + split_k * (local_query + tile_queries * out_stream));
                data_dst[lm_base + query_head] = floatBitsToUint(sh_denominator[gi]);
                data_dst[lm_base + n_query_heads + query_head] = floatBitsToUint(sh_maximum[gi]);
            }
        }
        return;
    }

    if (lane == 0u) {
        for (uint gi = 0u; gi < active_heads; ++gi) {
            const uint query_head = query_head_first + gi;
            if ((p.flags & FLAG_SINKS) != 0u) {
                const float score = uintBitsToFloat(data_sinks[query_head]);
                const float next_maximum = max(sh_maximum[gi], score);
                sh_old_scale[gi] = sh_maximum[gi] < -3.0e38 ?
                    0.0 : exp(sh_maximum[gi] - next_maximum);
                sh_denominator[gi] = sh_denominator[gi] * sh_old_scale[gi] +
                    exp(score - next_maximum);
                sh_maximum[gi] = next_maximum;
            } else {
                sh_old_scale[gi] = 1.0;
            }
            sh_weight[gi] = sh_denominator[gi] > 0.0 ? 1.0 / sh_denominator[gi] : 0.0;
        }
    }
    barrier();

    for (uint gi = 0u; gi < active_heads; ++gi) {
        const uint query_head = query_head_first + gi;
        const uint dst_base = query_head * head_dim +
            query * head_dim * n_query_heads +
            out_stream * head_dim * n_query_heads * n_query();
        for (uint slice = 0u; slice < head_slices(); ++slice) {
            const uint dim = slice * KVAR_N_DIM + lane;
            data_dst[dst_base + dim] = floatBitsToUint(
                accumulator[gi * 4u + slice] * sh_old_scale[gi] * sh_weight[gi]);
        }
    }
}

#endif
